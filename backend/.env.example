# Banco de dados
MONGODB_URI=mongodb+srv://usuario:senha@cluster.mongodb.net/?appName=Cluster0
PORT=4000

# Painel administrativo
ADMIN_USER=admin
ADMIN_PASS=troque-esta-senha
JWT_SECRET=gere-um-segredo-aleatorio-de-64-caracteres
JWT_EXPIRES_IN=7d

# Domínios liberados no CORS (separados por vírgula)
CORS_ORIGINS=https://marina-agili.vercel.app

# ---------- Bot do WhatsApp (Cloud API) ----------
# Token de acesso do app da Meta
WHATSAPP_TOKEN=
# ID do número de telefone (WhatsApp Manager > Números)
WHATSAPP_PHONE_NUMBER_ID=
# Frase secreta que você inventa e repete no painel da Meta ao cadastrar o webhook
WHATSAPP_VERIFY_TOKEN=
# App Secret da Meta — valida a assinatura X-Hub-Signature-256 dos eventos
WHATSAPP_APP_SECRET=
# Versão da Graph API
WHATSAPP_API_VERSION=v22.0

# 1 = modo simulado: não envia mensagens nem grava agendamento (para testes)
BOT_DRY_RUN=0
